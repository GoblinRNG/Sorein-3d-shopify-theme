<style>
  #srn-powers-{{ section.id }} {
    background: #090b0f;
    padding: 88px 0 100px;
    position: relative;
    overflow: hidden;
  }

  /* Blueprint grid overlay */
  #srn-powers-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(34,211,238,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34,211,238,0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
    z-index: 0;
  }

  /* Radial fade so grid fades to black at edges */
  #srn-powers-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 70% at 50% 50%, transparent 30%, #090b0f 100%);
    pointer-events: none;
    z-index: 1;
  }

  #srn-powers-{{ section.id }} > * {
    position: relative;
    z-index: 2;
  }

  #srn-powers-{{ section.id }} .srn-powers__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 56px;
  }

  #srn-powers-{{ section.id }} .srn-powers__h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #f4f6fa;
    margin: 12px 0 16px;
    line-height: 1.15;
  }

  #srn-powers-{{ section.id }} .srn-powers__sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(244,246,250,0.60);
    margin: 0;
  }

  #srn-powers-{{ section.id }} .srn-powers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 56px;
  }

  @media (min-width: 768px) {
    #srn-powers-{{ section.id }} .srn-powers__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  #srn-powers-{{ section.id }} .srn-device-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 20px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1),
                border-color 0.25s ease,
                box-shadow 0.35s cubic-bezier(0.22,1,0.36,1);
    opacity: 0;
    transform: translateY(20px);
  }

  #srn-powers-{{ section.id }} .srn-device-card.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s cubic-bezier(0.22,1,0.36,1),
                transform 0.5s cubic-bezier(0.22,1,0.36,1),
                border-color 0.25s ease,
                box-shadow 0.35s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-powers-{{ section.id }} .srn-device-card:hover {
    border-color: rgba(34,211,238,0.30);
    box-shadow: 0 0 24px rgba(34,211,238,0.07);
    transform: translateY(-4px);
  }

  #srn-powers-{{ section.id }} .srn-device-card.srn-visible:hover {
    transform: translateY(-4px);
  }

  #srn-powers-{{ section.id }} .srn-device-card__icon {
    font-size: 1.75rem;
    line-height: 1;
    display: block;
  }

  #srn-powers-{{ section.id }} .srn-device-card__name {
    font-size: 0.875rem;
    font-weight: 700;
    color: #f4f6fa;
    margin: 4px 0 0;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  #srn-powers-{{ section.id }} .srn-device-card__watts {
    font-size: 0.78rem;
    font-weight: 600;
    color: #22d3ee;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  #srn-powers-{{ section.id }} .srn-device-card__runtime {
    font-size: 0.75rem;
    color: rgba(244,246,250,0.45);
    line-height: 1.4;
  }

  #srn-powers-{{ section.id }} .srn-device-card__category {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    border-radius: 50px;
    margin-top: 4px;
    align-self: flex-start;
  }

  #srn-powers-{{ section.id }} .srn-device-card__category--essential {
    background: rgba(16,185,129,0.15);
    color: #10b981;
    border: 1px solid rgba(16,185,129,0.25);
  }

  #srn-powers-{{ section.id }} .srn-device-card__category--comfort {
    background: rgba(14,165,233,0.15);
    color: #0ea5e9;
    border: 1px solid rgba(14,165,233,0.25);
  }

  #srn-powers-{{ section.id }} .srn-device-card__category--work {
    background: rgba(20,184,166,0.15);
    color: #14b8a6;
    border: 1px solid rgba(20,184,166,0.25);
  }

  #srn-powers-{{ section.id }} .srn-device-card__category--emergency {
    background: rgba(34,211,238,0.10);
    color: #22d3ee;
    border: 1px solid rgba(34,211,238,0.22);
  }

  #srn-powers-{{ section.id }} .srn-powers__cta {
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    #srn-powers-{{ section.id }} .srn-device-card {
      opacity: 1;
      transform: none;
    }
    #srn-powers-{{ section.id }} .srn-device-card:hover {
      transform: none;
    }
  }
</style>

<section id="srn-powers-{{ section.id }}" aria-labelledby="srn-powers-h2-{{ section.id }}">
  <div class="srn-container">
    <div class="srn-powers__header">
      {% if section.settings.eyebrow != blank %}
        <p class="srn-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="srn-powers__h2" id="srn-powers-h2-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="srn-powers__sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="srn-powers__grid" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'device' %}
            <div class="srn-device-card" role="listitem" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="srn-device-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <h3 class="srn-device-card__name">{{ block.settings.name }}</h3>
              {% if block.settings.watts != blank %}
                <div class="srn-device-card__watts">{{ block.settings.watts }}</div>
              {% endif %}
              {% if block.settings.runtime != blank %}
                <div class="srn-device-card__runtime">{{ block.settings.runtime }}</div>
              {% endif %}
              {% if block.settings.category != blank %}
                <span class="srn-device-card__category srn-device-card__category--{{ block.settings.category }}">
                  {{ block.settings.category }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <div class="srn-powers__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="srn-btn srn-btn--dark">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('srn-powers-{{ section.id }}');
  if (!section) return;

  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var cards = section.querySelectorAll('.srn-device-card');

  if (prefersReduced) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('srn-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

  cards.forEach(function(card, i) {
    card.style.transitionDelay = (i * 55) + 'ms';
    observer.observe(card);
  });
})();
</script>

