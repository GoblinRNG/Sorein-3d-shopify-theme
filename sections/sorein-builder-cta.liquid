<style>
  #srn-buildercta-{{ section.id }} {
    background: #090b0f;
    padding: 100px 0 108px;
    position: relative;
    overflow: hidden;
  }

  /* Cyan gradient top edge */
  #srn-buildercta-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #22d3ee 30%, #0ea5e9 70%, transparent);
    z-index: 1;
  }

  /* Ambient glow */
  #srn-buildercta-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(34,211,238,0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  #srn-buildercta-{{ section.id }} > .srn-container {
    position: relative;
    z-index: 2;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
  }

  @media (min-width: 960px) {
    #srn-buildercta-{{ section.id }} .srn-buildercta__layout {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  /* Content side */
  #srn-buildercta-{{ section.id }} .srn-buildercta__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__h2 {
    font-size: clamp(2.125rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #f4f6fa;
    margin: 0;
    line-height: 1.08;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__h2 em {
    font-style: normal;
    background: linear-gradient(90deg, #22d3ee, #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(244,246,250,0.60);
    margin: 0;
    max-width: 460px;
  }

  /* Capacity preview pill */
  #srn-buildercta-{{ section.id }} .srn-buildercta__capacity {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.22);
    border-radius: 50px;
    padding: 8px 16px;
    width: fit-content;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__capacity-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22d3ee;
    animation: srn-pulse-{{ section.id }} 2s ease-in-out infinite;
  }

  @keyframes srn-pulse-{{ section.id }} {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.7); }
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__capacity-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #22d3ee;
    letter-spacing: 0.02em;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Large primary button */
  #srn-buildercta-{{ section.id }} .srn-buildercta__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, #22d3ee, #0ea5e9);
    color: #090b0f;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    border-radius: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1),
                box-shadow 0.3s cubic-bezier(0.22,1,0.36,1),
                filter 0.2s ease;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(34,211,238,0.35);
    filter: brightness(1.08);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__cta-primary:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 3px;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 28px;
    background: transparent;
    color: rgba(244,246,250,0.75);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.16);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.3s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__cta-secondary:hover {
    border-color: rgba(255,255,255,0.35);
    color: #f4f6fa;
    transform: translateY(-2px);
  }

  /* Trust row */
  #srn-buildercta-{{ section.id }} .srn-buildercta__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 4px;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__trust-item {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(244,246,250,0.45);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.01em;
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__trust-item::before {
    content: '';
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #22d3ee;
    flex-shrink: 0;
  }

  /* Image side */
  #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap:hover img {
    transform: scale(1.03);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6rem;
    color: rgba(244,246,250,0.07);
  }

  /* Entry animation */
  #srn-buildercta-{{ section.id }} .srn-buildercta__content,
  #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap {
    opacity: 0;
    transform: translateY(28px);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__content.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.65s 0.15s cubic-bezier(0.22,1,0.36,1), transform 0.65s 0.15s cubic-bezier(0.22,1,0.36,1);
  }

  @media (prefers-reduced-motion: reduce) {
    #srn-buildercta-{{ section.id }} .srn-buildercta__capacity-dot {
      animation: none;
    }
    #srn-buildercta-{{ section.id }} .srn-buildercta__content,
    #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap {
      opacity: 1;
      transform: none;
    }
    #srn-buildercta-{{ section.id }} .srn-buildercta__cta-primary:hover,
    #srn-buildercta-{{ section.id }} .srn-buildercta__cta-secondary:hover {
      transform: none;
    }
    #srn-buildercta-{{ section.id }} .srn-buildercta__image-wrap:hover img {
      transform: none;
    }
  }
</style>

<section id="srn-buildercta-{{ section.id }}" aria-labelledby="srn-buildercta-h2-{{ section.id }}">
  <div class="srn-container">
    <div class="srn-buildercta__layout">
      <div class="srn-buildercta__content">
        {% if section.settings.eyebrow != blank %}
          <p class="srn-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h2 class="srn-buildercta__h2" id="srn-buildercta-h2-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.subheading != blank %}
          <p class="srn-buildercta__sub">{{ section.settings.subheading }}</p>
        {% endif %}

        {% if section.settings.capacity_min != blank or section.settings.capacity_max != blank %}
          <div class="srn-buildercta__capacity" aria-label="System capacity range">
            <div class="srn-buildercta__capacity-dot" aria-hidden="true"></div>
            <span class="srn-buildercta__capacity-text">
              From {{ section.settings.capacity_min }} to {{ section.settings.capacity_max }}
            </span>
          </div>
        {% endif %}

        <div class="srn-buildercta__ctas">
          {% if section.settings.cta_primary_label != blank %}
            <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="srn-buildercta__cta-primary">
              {{ section.settings.cta_primary_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {% endif %}
          {% if section.settings.cta_secondary_label != blank %}
            <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="srn-buildercta__cta-secondary">
              {{ section.settings.cta_secondary_label }}
            </a>
          {% endif %}
        </div>

        <div class="srn-buildercta__trust" aria-label="Trust indicators">
          {% if section.settings.trust_1 != blank %}
            <span class="srn-buildercta__trust-item">{{ section.settings.trust_1 }}</span>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <span class="srn-buildercta__trust-item">{{ section.settings.trust_2 }}</span>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <span class="srn-buildercta__trust-item">{{ section.settings.trust_3 }}</span>
          {% endif %}
        </div>
      </div>

      <div class="srn-buildercta__image-wrap">
        {% if section.settings.hero_image != blank %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 900 }}"
            alt="{{ section.settings.hero_image.alt | escape | default: 'Sorein A6 Pro power station' }}"
            width="900"
            height="675"
            loading="lazy"
          >
        {% else %}
          <div class="srn-buildercta__image-placeholder" aria-hidden="true">⚡</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('srn-buildercta-{{ section.id }}');
  if (!section) return;

  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;

  var targets = section.querySelectorAll('.srn-buildercta__content, .srn-buildercta__image-wrap');

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('srn-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  targets.forEach(function(el) { observer.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Builder CTA",
  "tag": "section",
  "class": "srn-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Flagship system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Configure your perfect power setup"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your base, add batteries and inverters, and build the exact system your home, cabin, or RV needs."
    },
    {
      "type": "text",
      "id": "capacity_min",
      "label": "Min capacity",
      "default": "1 037 Wh"
    },
    {
      "type": "text",
      "id": "capacity_max",
      "label": "Max capacity",
      "default": "9 677 Wh"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Build your system"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "View A6 Pro specs"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Trust row"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "Free delivery to Sweden"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "5-year warranty"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "LiFePO4 safe chemistry"
    }
  ],
  "presets": [
    {
      "name": "Builder CTA"
    }
  ]
}
{% endschema %}
