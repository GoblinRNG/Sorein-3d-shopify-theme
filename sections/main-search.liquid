{% comment %}
  Section: main-search.liquid
  Purpose: Search results page
{% endcomment %}

<section id="srn-search-{{ section.id }}" class="srn-search-page">
  <style>
    #srn-search-{{ section.id }} {
      background: #f8f9fb;
      padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 60px);
    }
    #srn-search-{{ section.id }} .srn-search__inner { max-width: 1280px; margin: 0 auto; }
    #srn-search-{{ section.id }} .srn-search__title {
      font-size: clamp(24px, 3.5vw, 40px);
      font-weight: 700;
      color: #111318;
      margin: 0 0 32px;
      letter-spacing: -0.022em;
    }
    #srn-search-{{ section.id }} .srn-search__form {
      display: flex;
      gap: 12px;
      max-width: 600px;
      margin-bottom: 48px;
    }
    #srn-search-{{ section.id }} .srn-search__input {
      flex: 1;
      padding: 14px 18px;
      border: 1.5px solid rgba(17,19,24,0.12);
      border-radius: 10px;
      font-size: 15px;
      background: #fff;
      color: #111318;
      outline: none;
      transition: border-color 200ms;
    }
    #srn-search-{{ section.id }} .srn-search__input:focus {
      border-color: #22d3ee;
    }
    #srn-search-{{ section.id }} .srn-search__submit {
      padding: 14px 24px;
      background: linear-gradient(128deg, #22d3ee 0%, #0ea5e9 100%);
      color: #07090d;
      font-weight: 700;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      font-size: 14px;
    }
    #srn-search-{{ section.id }} .srn-search__results-count {
      font-size: 14px;
      color: rgba(17,19,24,0.55);
      margin-bottom: 24px;
    }
    #srn-search-{{ section.id }} .srn-search__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
    }
    #srn-search-{{ section.id }} .srn-search__no-results {
      text-align: center;
      padding: 64px 24px;
      color: rgba(17,19,24,0.55);
    }
    #srn-search-{{ section.id }} .srn-search__no-results h2 {
      font-size: 24px;
      font-weight: 700;
      color: #111318;
      margin: 0 0 12px;
    }
  </style>

  <div class="srn-search__inner">
    <h1 class="srn-search__title">
      {%- if search.performed -%}
        Search results for &ldquo;{{ search.terms | escape }}&rdquo;
      {%- else -%}
        Search
      {%- endif -%}
    </h1>

    <form action="{{ routes.search_url }}" method="get" class="srn-search__form" role="search">
      <input
        type="search"
        name="q"
        class="srn-search__input"
        value="{{ search.terms | escape }}"
        placeholder="Search Sorein products..."
        aria-label="Search products"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="srn-search__submit">Search</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="srn-search__results-count">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;
        </p>
        <div class="srn-search__grid">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'sorein-product-card', product: result -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="srn-search__no-results">
          <h2>No results found</h2>
          <p>Try a different search term, or browse our <a href="{{ routes.all_products_collection_url }}" style="color:#22d3ee">full product range</a>.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Search Results" }]
}
{% endschema %}
