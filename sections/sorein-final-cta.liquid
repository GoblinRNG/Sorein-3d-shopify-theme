<style>
  #srn-finalcta-{{ section.id }} {
    background: #07090d;
    padding: 100px 0 108px;
    position: relative;
    overflow: hidden;
  }

  /* Cyan gradient edges */
  #srn-finalcta-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 0% 100%, rgba(34,211,238,0.055) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 100% 0%, rgba(14,165,233,0.04) 0%, transparent 55%);
    pointer-events: none;
    z-index: 0;
  }

  #srn-finalcta-{{ section.id }} > .srn-container {
    position: relative;
    z-index: 1;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
  }

  @media (min-width: 960px) {
    #srn-finalcta-{{ section.id }} .srn-finalcta__layout {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }

    #srn-finalcta-{{ section.id }} .srn-finalcta__layout--no-image {
      grid-template-columns: 1fr;
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }
  }

  /* Content */
  #srn-finalcta-{{ section.id }} .srn-finalcta__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateY(28px);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__content.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #f4f6fa;
    margin: 0;
    line-height: 1.08;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__h2 em {
    font-style: normal;
    background: linear-gradient(90deg, #22d3ee, #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(244,246,250,0.60);
    margin: 0;
  }

  @media (min-width: 960px) {
    #srn-finalcta-{{ section.id }} .srn-finalcta__layout--no-image .srn-finalcta__sub {
      max-width: 520px;
      margin: 0 auto;
    }
  }

  /* CTA buttons */
  #srn-finalcta-{{ section.id }} .srn-finalcta__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 960px) {
    #srn-finalcta-{{ section.id }} .srn-finalcta__layout--no-image .srn-finalcta__ctas {
      justify-content: center;
    }
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 36px;
    background: linear-gradient(135deg, #22d3ee, #0ea5e9);
    color: #090b0f;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1),
                box-shadow 0.3s cubic-bezier(0.22,1,0.36,1),
                filter 0.2s ease;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 44px rgba(34,211,238,0.38);
    filter: brightness(1.08);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__btn-primary:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 3px;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 17px 28px;
    background: transparent;
    color: rgba(244,246,250,0.75);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.18);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.3s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__btn-secondary:hover {
    border-color: rgba(255,255,255,0.40);
    color: #f4f6fa;
    transform: translateY(-2px);
  }

  /* Trust text */
  #srn-finalcta-{{ section.id }} .srn-finalcta__trust {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(244,246,250,0.38);
    letter-spacing: 0.02em;
    line-height: 1.6;
    margin-top: 4px;
  }

  /* Image side */
  #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    opacity: 0;
    transform: translateY(28px);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.65s 0.15s cubic-bezier(0.22,1,0.36,1),
                transform 0.65s 0.15s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap:hover img {
    transform: scale(1.03);
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6rem;
    color: rgba(244,246,250,0.07);
  }

  /* Floating badge */
  #srn-finalcta-{{ section.id }} .srn-finalcta__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(9,11,15,0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(34,211,238,0.25);
    border-radius: 10px;
    padding: 10px 14px;
    z-index: 2;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__badge-value {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: #22d3ee;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  #srn-finalcta-{{ section.id }} .srn-finalcta__badge-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(244,246,250,0.50);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    #srn-finalcta-{{ section.id }} .srn-finalcta__content,
    #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap {
      opacity: 1;
      transform: none;
    }
    #srn-finalcta-{{ section.id }} .srn-finalcta__btn-primary:hover,
    #srn-finalcta-{{ section.id }} .srn-finalcta__btn-secondary:hover {
      transform: none;
    }
    #srn-finalcta-{{ section.id }} .srn-finalcta__image-wrap:hover img {
      transform: none;
    }
  }
</style>

{% assign has_image = false %}
{% if section.settings.show_image and section.settings.hero_image != blank %}
  {% assign has_image = true %}
{% endif %}

<section id="srn-finalcta-{{ section.id }}" aria-labelledby="srn-finalcta-h2-{{ section.id }}">
  <div class="srn-container">
    <div class="srn-finalcta__layout{% unless has_image %} srn-finalcta__layout--no-image{% endunless %}">

      <div class="srn-finalcta__content">
        {% if section.settings.eyebrow != blank %}
          <p class="srn-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="srn-finalcta__h2" id="srn-finalcta-h2-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
        {% if section.settings.subheading != blank %}
          <p class="srn-finalcta__sub">{{ section.settings.subheading }}</p>
        {% endif %}

        <div class="srn-finalcta__ctas">
          {% if section.settings.cta_primary_label != blank %}
            <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="srn-finalcta__btn-primary">
              {{ section.settings.cta_primary_label }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {% endif %}
          {% if section.settings.cta_secondary_label != blank %}
            <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="srn-finalcta__btn-secondary">
              {{ section.settings.cta_secondary_label }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.trust_text != blank %}
          <p class="srn-finalcta__trust">{{ section.settings.trust_text }}</p>
        {% endif %}
      </div>

      {% if has_image %}
        <div class="srn-finalcta__image-wrap">
          <img
            src="{{ section.settings.hero_image | image_url: width: 900 }}"
            alt="{{ section.settings.hero_image.alt | escape | default: 'Sorein power station' }}"
            width="900"
            height="675"
            loading="lazy"
          >
          <div class="srn-finalcta__badge">
            <span class="srn-finalcta__badge-value">5-yr</span>
            <span class="srn-finalcta__badge-label">Warranty</span>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('srn-finalcta-{{ section.id }}');
  if (!section) return;

  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;

  var targets = section.querySelectorAll('.srn-finalcta__content, .srn-finalcta__image-wrap');

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('srn-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  targets.forEach(function(el) { observer.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "class": "srn-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Ready when you are"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your backup power is one click away."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "LiFePO4 safety. 5-year warranty. Modular design that grows with your needs. Free delivery to Sweden."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Product image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Build your system"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Browse all products"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "textarea",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Free delivery · 5-year warranty · LiFePO4 safety · Expert support"
    }
  ],
  "presets": [
    {
      "name": "Final CTA"
    }
  ]
}
{% endschema %}
