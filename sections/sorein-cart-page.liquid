{% comment %}Section: sorein-cart-page.liquid — Full cart page with AJAX quantity controls{% endcomment %}
{%- liquid assign sid = section.id -%}
<section id="srn-cartpage-{{ sid }}" class="srn-cartpage">
<style>
#srn-cartpage-{{ sid }} { background:#f8f9fb; padding:clamp(48px,7vw,88px) clamp(20px,5vw,60px); min-height:60vh; }
#srn-cartpage-{{ sid }} .srn-cart__inner { max-width:1280px; margin:0 auto; display:grid; grid-template-columns:1fr; gap:32px; }
@media(min-width:900px){ #srn-cartpage-{{ sid }} .srn-cart__inner { grid-template-columns:1fr 380px; align-items:start; } }
#srn-cartpage-{{ sid }} h1 { font-size:clamp(24px,3.5vw,38px); font-weight:700; letter-spacing:-0.022em; color:#111318; margin:0 0 32px; }
#srn-cartpage-{{ sid }} .srn-cart__items { display:flex; flex-direction:column; gap:0; background:#fff; border-radius:16px; border:1px solid rgba(17,19,24,0.08); overflow:hidden; }
#srn-cartpage-{{ sid }} .srn-cart__item { display:grid; grid-template-columns:80px 1fr auto; gap:16px; padding:20px; border-bottom:1px solid rgba(17,19,24,0.07); align-items:start; }
#srn-cartpage-{{ sid }} .srn-cart__item:last-child { border-bottom:none; }
#srn-cartpage-{{ sid }} .srn-cart__img { width:80px; height:80px; border-radius:8px; object-fit:cover; background:#f0f2f5; flex-shrink:0; }
#srn-cartpage-{{ sid }} .srn-cart__img-placeholder { width:80px; height:80px; border-radius:8px; background:#f0f2f5; display:flex; align-items:center; justify-content:center; }
#srn-cartpage-{{ sid }} .srn-cart__details { min-width:0; }
#srn-cartpage-{{ sid }} .srn-cart__item-title { font-size:15px; font-weight:700; color:#111318; margin:0 0 4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#srn-cartpage-{{ sid }} .srn-cart__item-variant { font-size:12.5px; color:rgba(17,19,24,0.50); margin:0 0 12px; }
#srn-cartpage-{{ sid }} .srn-cart__qty-wrap { display:flex; align-items:center; gap:8px; }
#srn-cartpage-{{ sid }} .srn-cart__qty-btn { width:32px; height:32px; border-radius:8px; border:1.5px solid rgba(17,19,24,0.12); background:#fff; color:#111318; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 180ms; }
#srn-cartpage-{{ sid }} .srn-cart__qty-btn:hover { border-color:#22d3ee; color:#22d3ee; }
#srn-cartpage-{{ sid }} .srn-cart__qty-num { min-width:32px; text-align:center; font-size:15px; font-weight:700; color:#111318; }
#srn-cartpage-{{ sid }} .srn-cart__remove { font-size:12px; color:rgba(17,19,24,0.40); background:none; border:none; cursor:pointer; padding:0; text-decoration:underline; margin-top:8px; }
#srn-cartpage-{{ sid }} .srn-cart__remove:hover { color:#111318; }
#srn-cartpage-{{ sid }} .srn-cart__line-price { font-size:15px; font-weight:700; color:#111318; white-space:nowrap; padding-top:2px; }
#srn-cartpage-{{ sid }} .srn-cart__summary { background:#fff; border-radius:16px; border:1px solid rgba(17,19,24,0.08); padding:24px; position:sticky; top:100px; }
#srn-cartpage-{{ sid }} .srn-cart__summary h2 { font-size:17px; font-weight:700; color:#111318; margin:0 0 20px; }
#srn-cartpage-{{ sid }} .srn-cart__summary-row { display:flex; justify-content:space-between; align-items:center; font-size:14px; color:rgba(17,19,24,0.65); margin-bottom:10px; }
#srn-cartpage-{{ sid }} .srn-cart__total-row { display:flex; justify-content:space-between; align-items:center; font-size:18px; font-weight:700; color:#111318; padding-top:14px; border-top:1px solid rgba(17,19,24,0.08); margin:14px 0 20px; }
#srn-cartpage-{{ sid }} .srn-cart__checkout { display:block; width:100%; padding:16px; background:linear-gradient(128deg,#22d3ee 0%,#0ea5e9 100%); color:#07090d; font-size:16px; font-weight:700; border:none; border-radius:10px; cursor:pointer; text-align:center; text-decoration:none; transition:all 220ms; box-shadow:0 2px 16px rgba(34,211,238,0.20); }
#srn-cartpage-{{ sid }} .srn-cart__checkout:hover { box-shadow:0 4px 28px rgba(34,211,238,0.35); transform:translateY(-1px); }
#srn-cartpage-{{ sid }} .srn-cart__continue { display:block; text-align:center; margin-top:12px; font-size:13px; color:rgba(17,19,24,0.50); text-decoration:underline; text-underline-offset:2px; }
#srn-cartpage-{{ sid }} .srn-cart__continue:hover { color:#111318; }
#srn-cartpage-{{ sid }} .srn-cart__note-toggle { font-size:13px; color:#0ea5e9; background:none; border:none; cursor:pointer; padding:8px 0 0; }
#srn-cartpage-{{ sid }} .srn-cart__note { display:none; margin-top:12px; }
#srn-cartpage-{{ sid }} .srn-cart__note textarea { width:100%; padding:10px 12px; border:1.5px solid rgba(17,19,24,0.12); border-radius:8px; font-size:14px; resize:vertical; min-height:80px; }
#srn-cartpage-{{ sid }} .srn-cart__note.is-open { display:block; }
#srn-cartpage-{{ sid }} .srn-cart__empty { text-align:center; padding:80px 24px; }
#srn-cartpage-{{ sid }} .srn-cart__empty h2 { font-size:24px; font-weight:700; color:#111318; margin:0 0 12px; }
#srn-cartpage-{{ sid }} .srn-cart__empty p { color:rgba(17,19,24,0.55); margin:0 0 24px; }
#srn-cartpage-{{ sid }} .srn-cart__delivery { font-size:12px; color:rgba(17,19,24,0.50); text-align:center; margin-top:10px; }
@media(prefers-reduced-motion:reduce){ #srn-cartpage-{{ sid }} .srn-cart__checkout { transition:none; } #srn-cartpage-{{ sid }} .srn-cart__checkout:hover { transform:none; } }
</style>

<div class="srn-cart__inner">
  {%- if cart.item_count > 0 -%}
  <div>
    <h1>Your cart ({{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %})</h1>
    <div class="srn-cart__items" id="srn-cart-items-{{ sid }}">
      {%- for item in cart.items -%}
      <div class="srn-cart__item" data-key="{{ item.key }}" data-variant="{{ item.variant_id }}">
        <a href="{{ item.url }}">
          {%- if item.image -%}
          {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'srn-cart__img', alt: item.image.alt | default: item.title | escape, widths: '80,160' }}
          {%- else -%}
          <div class="srn-cart__img-placeholder" aria-hidden="true">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </a>
        <div class="srn-cart__details">
          <p class="srn-cart__item-title"><a href="{{ item.url }}" style="color:inherit;text-decoration:none;">{{ item.product.title }}</a></p>
          {%- if item.variant.title != 'Default Title' -%}<p class="srn-cart__item-variant">{{ item.variant.title }}</p>{%- endif -%}
          <div class="srn-cart__qty-wrap">
            <button class="srn-cart__qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
            <span class="srn-cart__qty-num">{{ item.quantity }}</span>
            <button class="srn-cart__qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
          </div>
          <button class="srn-cart__remove" data-action="remove">Remove</button>
        </div>
        <div class="srn-cart__line-price">{{ item.final_line_price | money }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="srn-cart__summary">
    <h2>Order summary</h2>
    <div class="srn-cart__summary-row"><span>Subtotal</span><span id="srn-cart-subtotal-{{ sid }}">{{ cart.total_price | money }}</span></div>
    <div class="srn-cart__summary-row"><span>Shipping</span><span>{{ section.settings.delivery_text | default: 'Free' }}</span></div>
    <div class="srn-cart__total-row"><span>Total</span><span id="srn-cart-total-{{ sid }}">{{ cart.total_price | money }}</span></div>
    <a href="{{ routes.checkout_url }}" class="srn-cart__checkout">Proceed to checkout</a>
    <a href="{{ routes.all_products_collection_url }}" class="srn-cart__continue">Continue shopping</a>
    {%- if section.settings.show_note -%}
    <button class="srn-cart__note-toggle" type="button" onclick="this.nextElementSibling.classList.toggle('is-open')">+ Add a note</button>
    <div class="srn-cart__note">
      <textarea name="note" placeholder="Special instructions..." aria-label="Order note">{{ cart.note }}</textarea>
    </div>
    {%- endif -%}
    <p class="srn-cart__delivery">🔒 Secure checkout · {{ section.settings.delivery_text | default: 'Free delivery' }}</p>
    {%- render 'sorein-trust-row' -%}
  </div>
  {%- else -%}
  <div class="srn-cart__empty">
    <div aria-hidden="true" style="font-size:48px;margin-bottom:16px;">🛒</div>
    <h2>Your cart is empty</h2>
    <p>Looks like you haven't added any products yet.</p>
    <a href="{{ routes.all_products_collection_url }}" class="srn-btn srn-btn--primary">Browse products</a>
  </div>
  {%- endif -%}
</div>
</section>

<script>
(function(){
  'use strict';
  var ROOT = document.getElementById('srn-cartpage-{{ sid }}');
  if(!ROOT) return;
  ROOT.addEventListener('click', function(e){
    var btn = e.target.closest('[data-action]');
    if(!btn) return;
    var item = btn.closest('[data-key]');
    if(!item) return;
    var key = item.dataset.key;
    var qtyEl = item.querySelector('.srn-cart__qty-num');
    var qty = parseInt(qtyEl ? qtyEl.textContent : '0', 10);
    var action = btn.dataset.action;
    var newQty = action === 'increase' ? qty + 1 : action === 'decrease' ? Math.max(0, qty - 1) : 0;
    fetch('/cart/change.js', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({id: key, quantity: newQty})
    }).then(function(r){ return r.json(); }).then(function(cart){
      if(newQty === 0){ item.remove(); }
      else if(qtyEl){ qtyEl.textContent = newQty; }
      var sub = document.getElementById('srn-cart-subtotal-{{ sid }}');
      var tot = document.getElementById('srn-cart-total-{{ sid }}');
      if(sub && window.SoreinTheme){ sub.textContent = window.SoreinTheme.formatMoney(cart.total_price); }
      if(tot && window.SoreinTheme){ tot.textContent = window.SoreinTheme.formatMoney(cart.total_price); }
      if(window.SoreinTheme){ window.SoreinTheme.updateCartCount(cart.item_count); }
    }).catch(function(){ window.location.reload(); });
  });
})();
</script>

{% schema %}{"name":"Cart Page","tag":"section","settings":[{"type":"checkbox","id":"show_note","label":"Show order note field","default":true},{"type":"text","id":"delivery_text","label":"Delivery message","default":"Free delivery on all orders"},{"type":"checkbox","id":"show_trust_row","label":"Show trust row","default":true}],"presets":[{"name":"Cart Page"}]}{% endschema %}
