<script>
/* Sorein Hero Power — Section {{ sid }}
   Reveal animations via IntersectionObserver.
   Scoped IIFE — no global namespace pollution. */
(function () {
  'use strict';

  var ROOT = document.getElementById('sorein-hero-{{ sid }}');
  if (!ROOT) return;

  /* Respect prefers-reduced-motion — CSS handles static state, JS can bail */
  var reducedMotion =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) return;

  /* ── Utility: observe a NodeList, fire callback when each enters viewport ── */
  function observe(els, cb, opts) {
    if (!els || !els.length) return;
    if (!('IntersectionObserver' in window)) {
      /* Fallback: immediately visible */
      for (var i = 0; i < els.length; i++) cb(els[i], 0);
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          cb(entry.target, parseInt(entry.target.getAttribute('data-sorein-stat') || '0', 10));
          io.unobserve(entry.target);
        }
      });
    }, opts || { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    for (var j = 0; j < els.length; j++) io.observe(els[j]);
  }

  /* ── Content columns — fade up on enter ─────────────────────────────────── */
  var revealEls = ROOT.querySelectorAll('[data-sorein-reveal]');
  observe(revealEls, function (el) {
    el.classList.add('sorein-visible');
  });

  /* ── Stat cards — staggered fade up ─────────────────────────────────────── */
  var statEls = ROOT.querySelectorAll('[data-sorein-stat]');
  observe(
    statEls,
    function (el, idx) {
      setTimeout(function () {
        el.classList.add('sorein-visible');
      }, idx * 75);
    },
    { threshold: 0.15, rootMargin: '0px 0px -20px 0px' }
  );
})();
</script>

