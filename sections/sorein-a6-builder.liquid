</div>{%- comment %} /#srn-a6builder {% endcomment %}

{%- comment %} ── Visually hidden helper ─────────────────────────────── {% endcomment %}
<style>
  .srn-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
(function () {
  'use strict';

  var SID = {{ sid | json }};
  var $ = function (id) { return document.getElementById(id); };
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Read data ──────────────────────────────────────────────────────────────
  var dataEl = $('sorein-a6-data-' + SID);
  if (!dataEl) return;
  var DATA;
  try { DATA = JSON.parse(dataEl.textContent); }
  catch (e) { console.error('[SrnA6Builder] Failed to parse JSON data', e); return; }

  var MOD    = DATA.modules;
  var IMAGES = DATA.images;
  var ALTS   = DATA.imageAlts;
  var MAX_WH = DATA.maxCapacityWh": 9600;

  // ── State ──────────────────────────────────────────────────────────────────
  var state = {
    chassisId:  'mobile',
    eb210Qty:   0,
    ac200Qty:   0
  };

  // ── Helpers ─────────────────────────────────────────────────────────────────
  function fmtWh(n)  { return fmtNum(n) + ' Wh'; }
  function fmtW(n)   { return fmtNum(n) + ' W'; }
  function fmtKg(g)  { return (g / 1000).toFixed(1) + ' kg'; }
  function fmtNum(n) {
    // Space-separated thousands: 41 495
    return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  }
  function fmtSEK(n) { return fmtNum(n) + ' SEK'; }

  // Parse a display price string like "41 495" → numeric integer
  function parsePriceStr(str) {
    if (!str) return 0;
    return parseInt((str + '').replace(/[\s ]/g, ''), 10) || 0;
  }

  // ── Calculations ───────────────────────────────────────────────────────────
  function calcState() {
    var chassis = getSelectedChassis();

    var totalWh     = MOD.base.wh + (state.eb210Qty * MOD.eb210.wh);
    var totalW      = MOD.base.w  + (state.ac200Qty * MOD.ac200.w);
    var totalWeightG = MOD.base.weight_g
                      + (chassis ? chassis.weight_g : 0)
                      + (state.eb210Qty * MOD.eb210.weight_g)
                      + (state.ac200Qty * MOD.ac200.weight_g);

    var basePrice    = parsePriceStr(MOD.base.displayPrice);
    var chassisPrice = chassis ? parsePriceStr(chassis.displayPrice) : 0;
    var eb210Price   = state.eb210Qty * parsePriceStr(MOD.eb210.displayPrice);
    var ac200Price   = state.ac200Qty * parsePriceStr(MOD.ac200.displayPrice);
    var totalPrice   = basePrice + chassisPrice + eb210Price + ac200Price;

    return {
      totalWh:      totalWh,
      totalW:       totalW,
      totalWeightG: totalWeightG,
      totalPrice:   totalPrice,
      basePrice:    basePrice,
      chassisPrice: chassisPrice,
      eb210Price:   eb210Price,
      ac200Price:   ac200Price,
      chassis:      chassis
    };
  }

  function getSelectedChassis() {
    for (var i = 0; i < MOD.chassis.length; i++) {
      if (MOD.chassis[i].id === state.chassisId) return MOD.chassis[i];
    }
    return MOD.chassis[0];
  }

  // ── Render ─────────────────────────────────────────────────────────────────
  function render() {
    var c = calcState();
    updateNumbers(c);
    updateCapBar(c);
    updateSummaryRows(c);
    updateImage(c);
    updateKlarna(c);
    updateStepIcons();
  }

  function setText(id, val) {
    var el = $(id);
    if (el) el.textContent = val;
  }

  function updateNumbers(c) {
    // Hero price
    setText('srn-hero-price-' + SID, fmtNum(c.totalPrice));

    // Spec chips
    setText('srn-spec-output-' + SID, fmtNum(c.totalW));
    setText('srn-spec-cap-' + SID, fmtNum(c.totalWh));
    setText('srn-spec-weight-' + SID, (c.totalWeightG / 1000).toFixed(1));

    // Module prices
    var eb210LineEl = $('srn-eb210-price-' + SID);
    if (eb210LineEl) {
      eb210LineEl.textContent = state.eb210Qty > 0
        ? fmtNum(c.eb210Price) + ' SEK'
        : '—';
    }
    var ac200LineEl = $('srn-ac200-price-' + SID);
    if (ac200LineEl) {
      ac200LineEl.textContent = state.ac200Qty > 0
        ? fmtNum(c.ac200Price) + ' SEK'
        : '—';
    }

    // Stepper displays
    var eb210ValEl = $('srn-eb210-val-' + SID);
    if (eb210ValEl) {
      eb210ValEl.textContent = state.eb210Qty;
      eb210ValEl.setAttribute('aria-label', 'EB240 quantity: ' + state.eb210Qty);
    }
    var ac200ValEl = $('srn-ac200-val-' + SID);
    if (ac200ValEl) {
      ac200ValEl.textContent = state.ac200Qty;
      ac200ValEl.setAttribute('aria-label', 'AC300 quantity: ' + state.ac200Qty);
    }

    // Stepper button disabled states
    setDisabled('srn-eb210-dec-' + SID, state.eb210Qty <= MOD.eb210.min);
    setDisabled('srn-eb210-inc-' + SID, state.eb210Qty >= MOD.eb210.max);
    setDisabled('srn-ac200-dec-' + SID, state.ac200Qty <= MOD.ac200.min);
    setDisabled('srn-ac200-inc-' + SID, state.ac200Qty >= MOD.ac200.max);

    // Sticky bar price
    setText('srn-sticky-price-' + SID, fmtNum(c.totalPrice));
  }

  function setDisabled(id, bool) {
    var el = $(id);
    if (el) el.disabled = bool;
  }

  function updateCapBar(c) {
    var pct = Math.min(100, Math.round((c.totalWh / MAX_WH) * 1000) / 10);
    var fillEl = $('srn-cap-fill-' + SID);
    if (fillEl) fillEl.style.width = pct + '%';

    var trackEl = fillEl && fillEl.parentElement;
    if (trackEl) {
      trackEl.setAttribute('aria-valuenow', c.totalWh);
    }

    setText('srn-cap-wh-' + SID, fmtNum(c.totalWh));
    setText('srn-cap-pct-' + SID, pct.toFixed(1) + '% of max (' + fmtNum(MAX_WH) + ' Wh)');
  }

  function updateSummaryRows(c) {
    // Chassis row
    if (c.chassis) {
      setText('srn-sum-chassis-name-' + SID, c.chassis.title);
      setText('srn-sum-chassis-price-' + SID, fmtNum(c.chassisPrice) + ' SEK');
    }

    // EB240 row
    var eb210Row = $('srn-sum-eb210-row-' + SID);
    if (eb210Row) {
      eb210Row.style.display = state.eb210Qty > 0 ? '' : 'none';
      setText('srn-sum-eb210-qty-' + SID, '×' + state.eb210Qty);
      setText('srn-sum-eb210-price-' + SID, fmtNum(c.eb210Price) + ' SEK');
    }

    // AC300 row
    var ac200Row = $('srn-sum-ac200-row-' + SID);
    if (ac200Row) {
      ac200Row.style.display = state.ac200Qty > 0 ? '' : 'none';
      setText('srn-sum-ac200-qty-' + SID, '×' + state.ac200Qty);
      setText('srn-sum-ac200-price-' + SID, fmtNum(c.ac200Price) + ' SEK');
    }

    // Stats
    setText('srn-sum-stat-cap-' + SID, fmtNum(c.totalWh) + ' Wh');
    setText('srn-sum-stat-output-' + SID, fmtNum(c.totalW) + ' W');
    setText('srn-sum-stat-weight-' + SID, fmtKg(c.totalWeightG));

    // Summary total
    setText('srn-sum-total-' + SID, fmtNum(c.totalPrice));
  }

  function updateKlarna(c) {
    if (!DATA.showKlarna) return;
    var months  = DATA.klarnaMonths || 36;
    var monthly = Math.ceil(c.totalPrice / months);
    var txt     = '~' + fmtNum(monthly) + ' SEK/month over ' + months + ' months';

    setText('srn-sum-klarna-' + SID, txt);
    setText('srn-klarna-hero-' + SID, txt);
  }

  // ── Image switching ─────────────────────────────────────────────────────────
  var _currentBucket = 'default';
  var _imgFrontEl = null;
  var _imgBackEl  = null;

  function initImageEls() {
    _imgFrontEl = $('srn-img-front-' + SID);
    _imgBackEl  = $('srn-img-back-' + SID);
  }

  function weightToBucket(weightG) {
    var kg = weightG / 1000;
    if (kg < 20)  return 'default';
    if (kg < 35)  return 'low';
    if (kg < 55)  return 'medium';
    if (kg < 80)  return 'large';
    return 'full';
  }

  function updateImage(c) {
    var bucket = weightToBucket(c.totalWeightG);
    var src    = IMAGES[bucket] || IMAGES['default'];
    var alt    = ALTS[bucket]   || ALTS['default'] || 'A6 Pro configuration';

    // If image not set, fall back to default
    if (!src) {
      src = IMAGES['default'];
      alt = ALTS['default'] || 'Main Base 3600 Configuration';
    }

    if (bucket === _currentBucket) return;
    _currentBucket = bucket;

    if (!src || reducedMotion) {
      if (_imgFrontEl && src) {
        _imgFrontEl.src = src;
        _imgFrontEl.alt = alt;
      }
      return;
    }

    // Crossfade: load into back layer, then swap
    if (!_imgBackEl || !_imgFrontEl) return;

    _imgBackEl.src = src;
    _imgBackEl.alt = alt;
    _imgBackEl.style.opacity = '0';
    _imgBackEl.style.zIndex  = '1';
    _imgFrontEl.style.zIndex = '2';

    _imgBackEl.onload = function () {
      // Fade back in
      _imgBackEl.style.transition  = 'opacity 200ms ease';
      _imgFrontEl.style.transition = 'opacity 200ms ease';
      _imgBackEl.style.opacity  = '1';
      _imgFrontEl.style.opacity = '0';

      setTimeout(function () {
        // Promote back to front
        _imgFrontEl.src = src;
        _imgFrontEl.alt = alt;
        _imgFrontEl.style.opacity    = '1';
        _imgFrontEl.style.transition = '';
        _imgFrontEl.style.zIndex     = '2';
        _imgBackEl.style.opacity     = '0';
        _imgBackEl.style.zIndex      = '1';
        _imgBackEl.style.transition  = '';
      }, 210);
    };

    _imgBackEl.onerror = function () {
      // Silently fall back; don't swap
    };
  }

  // ── Step icon updates ──────────────────────────────────────────────────────
  var CHECKMARK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

  function updateStepIcons() {
    // Step 2 — chassis always selected
    var s2 = $('srn-step2-num-' + SID);
    if (s2 && !s2.classList.contains('srn-a6-step__num--done')) {
      s2.classList.add('srn-a6-step__num--done');
      s2.innerHTML = CHECKMARK;
      s2.setAttribute('aria-label', 'Step 2 complete');
    }

    // Step 3 — EB240
    var s3 = $('srn-step3-num-' + SID);
    if (s3) {
      if (state.eb210Qty > 0) {
        s3.classList.add('srn-a6-step__num--done');
        s3.innerHTML = CHECKMARK;
        s3.setAttribute('aria-label', 'Step 3 complete');
      } else {
        s3.classList.remove('srn-a6-step__num--done');
        s3.innerHTML = '3';
        s3.removeAttribute('aria-label');
      }
    }

    // Step 4 — AC300
    var s4 = $('srn-step4-num-' + SID);
    if (s4) {
      if (state.ac200Qty > 0) {
        s4.classList.add('srn-a6-step__num--done');
        s4.innerHTML = CHECKMARK;
        s4.setAttribute('aria-label', 'Step 4 complete');
      } else {
        s4.classList.remove('srn-a6-step__num--done');
        s4.innerHTML = '4';
        s4.removeAttribute('aria-label');
      }
    }
  }

  // ── Event: chassis radio ───────────────────────────────────────────────────
  function bindChassisRadios() {
    var radios = document.querySelectorAll(
      '#srn-a6builder-' + SID + ' input[name="srn-chassis-' + SID + '"]'
    );
    radios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        state.chassisId = this.value;
        render();
      });
    });
  }

  // ── Event: steppers ───────────────────────────────────────────────────────
  function bindStepper(decId, incId, key, min, max) {
    var decBtn = $(decId);
    var incBtn = $(incId);
    if (decBtn) {
      decBtn.addEventListener('click', function () {
        if (state[key] > min) {
          state[key]--;
          render();
        }
      });
    }
    if (incBtn) {
      incBtn.addEventListener('click', function () {
        if (state[key] < max) {
          state[key]++;
          render();
        }
      });
    }
  }

  // ── Add to Cart ────────────────────────────────────────────────────────────
  function buildCartItems() {
    var items = [];
    var chassis = getSelectedChassis();
    var buildConfig = {
      base:    { title: MOD.base.title, qty: 1 },
      chassis: { title: chassis ? chassis.title : '', qty: 1 },
      eb210:   { title: MOD.eb210.title, qty: state.eb210Qty },
      ac200:   { title: MOD.ac200.title, qty: state.ac200Qty }
    };
    var configStr = JSON.stringify(buildConfig);

    // Base
    if (MOD.base.variantId) {
      items.push({
        id:         MOD.base.variantId,
        quantity:   1,
        properties: { '_build_config': configStr, '_module': 'base' }
      });
    }

    // Chassis
    if (chassis && chassis.variantId) {
      items.push({
        id:         chassis.variantId,
        quantity:   1,
        properties: { '_build_config': configStr, '_module': 'chassis_' + chassis.id }
      });
    }

    // EB240
    if (state.eb210Qty > 0 && MOD.eb210.variantId) {
      items.push({
        id:         MOD.eb210.variantId,
        quantity:   state.eb210Qty,
        properties: { '_build_config': configStr, '_module': 'eb210' }
      });
    }

    // AC300
    if (state.ac200Qty > 0 && MOD.ac200.variantId) {
      items.push({
        id:         MOD.ac200.variantId,
        quantity:   state.ac200Qty,
        properties: { '_build_config': configStr, '_module': 'ac200' }
      });
    }

    return items;
  }

  function setLoadingState(loading) {
    var btns = [
      $('srn-atc-hero-' + SID),
      $('srn-atc-sum-' + SID),
      $('srn-atc-sticky-' + SID)
    ];
    btns.forEach(function (btn) {
      if (!btn) return;
      btn.disabled = loading;
      if (loading) {
        btn.classList.add('is-loading');
      } else {
        btn.classList.remove('is-loading');
      }
    });
  }

  function showError(msg) {
    var errHero = $('srn-atc-error-hero-' + SID);
    if (errHero) {
      errHero.textContent = msg;
      errHero.classList.add('is-visible');
    }
  }
  function hideError() {
    var errHero = $('srn-atc-error-hero-' + SID);
    if (errHero) {
      errHero.textContent = '';
      errHero.classList.remove('is-visible');
    }
  }

  function showSuccess(msg) {
    var succEl = $('srn-atc-success-hero-' + SID);
    if (succEl) {
      succEl.textContent = msg;
      succEl.classList.add('is-visible');
      setTimeout(function () { succEl.classList.remove('is-visible'); }, 4000);
    }
  }

  function addToCart() {
    var items = buildCartItems();
    if (items.length === 0) {
      showError('Please complete your configuration. Variant IDs may not be set yet — please contact support.');
      return;
    }

    hideError();
    setLoadingState(true);

    fetch('/cart/add.js', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body:    JSON.stringify({ items: items })
    })
    .then(function (res) {
      if (!res.ok) {
        return res.json().then(function (data) {
          throw new Error(data.description || 'Could not add to cart. Please try again.');
        });
      }
      return res.json();
    })
    .then(function () {
      setLoadingState(false);
      showSuccess('Added to cart! Your A6 Pro build is ready.');

      // Attempt to open cart drawer or update cart count
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      var cartCount = document.querySelectorAll('[data-cart-count],[js-cart-count]');
      // Refresh cart count via API
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          cartCount.forEach(function (el) {
            el.textContent = cart.item_count;
          });
        })
        .catch(function () {});
    })
    .catch(function (err) {
      setLoadingState(false);
      showError(err.message || 'Something went wrong. Please try again.');
    });
  }

  // ── Bind ATC buttons ────────────────────────────────────────────────────────
  function bindATC() {
    ['srn-atc-hero-' + SID, 'srn-atc-sum-' + SID, 'srn-atc-sticky-' + SID].forEach(function (id) {
      var btn = $(id);
      if (btn) btn.addEventListener('click', addToCart);
    });
  }

  // ── Init ───────────────────────────────────────────────────────────────────
  function init() {
    initImageEls();
    bindChassisRadios();
    bindStepper(
      'srn-eb210-dec-' + SID,
      'srn-eb210-inc-' + SID,
      'eb210Qty',
      MOD.eb210.min,
      MOD.eb210.max
    );
    bindStepper(
      'srn-ac200-dec-' + SID,
      'srn-ac200-inc-' + SID,
      'ac200Qty',
      MOD.ac200.min,
      MOD.ac200.max
    );
    bindATC();

    // Initial render
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

