{% comment %}
  Sorein A6 Pro Builder — Flagship Modular Power Station Configurator
  Shopify Online Store 2.0 section
  Scoped CSS + IIFE JS, no Liquid in schema defaults
{% endcomment %}

{%- liquid
  assign base_price_raw       = section.settings.base_price | default: '41 495'
  assign eb210_price_raw      = section.settings.eb210_price | default: '14 995'
  assign ac200_price_raw      = section.settings.ac200_price | default: '9 995'
  assign chassis_mobile_price = section.settings.chassis_mobile_price | default: '4 995'
  assign chassis_offroad_price = section.settings.chassis_offroad_price | default: '5 995'

  assign sid = section.id
-%}

{%- style -%}
/* ─── Reset / Scope ─────────────────────────────────────────── */
#srn-a6builder-{{ sid }} *,
#srn-a6builder-{{ sid }} *::before,
#srn-a6builder-{{ sid }} *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ─── Tokens ────────────────────────────────────────────────── */
#srn-a6builder-{{ sid }} {
  --srn-dark:         #090b0f;
  --srn-dark-2:       #111318;
  --srn-dark-3:       #181c24;
  --srn-light:        #f8f9fb;
  --srn-light-2:      #eef0f4;
  --srn-cyan:         #22d3ee;
  --srn-blue:         #0ea5e9;
  --srn-teal:         #14b8a6;
  --srn-text-dark:    #f4f6fa;
  --srn-sub-dark:     rgba(244,246,250,0.60);
  --srn-text-light:   #111318;
  --srn-sub-light:    rgba(17,19,24,0.60);
  --srn-border-dark:  rgba(255,255,255,0.08);
  --srn-card-dark:    rgba(255,255,255,0.04);
  --srn-card-dark-2:  rgba(255,255,255,0.07);
  --srn-radius-card:  16px;
  --srn-radius-btn:   10px;
  font-family: inherit;
}

/* ─── Hero / Purchase Area ──────────────────────────────────── */
.srn-a6-hero {
  background: var(--srn-dark);
  padding: 64px 32px 72px;
}
.srn-a6-hero__inner {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: start;
}

/* ─── Preview Card (left) ───────────────────────────────────── */
.srn-a6-preview {
  position: sticky;
  top: 80px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.srn-a6-preview__img-wrap {
  position: relative;
  border-radius: var(--srn-radius-card);
  overflow: hidden;
  background: var(--srn-dark-3);
  aspect-ratio: 4/3;
  border: 1px solid var(--srn-border-dark);
}
.srn-a6-preview__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 20px;
  transition: opacity 200ms ease;
}
.srn-a6-preview__img--back {
  opacity: 0;
  z-index: 1;
}
.srn-a6-preview__img--front {
  opacity: 1;
  z-index: 2;
}
.srn-a6-preview__img--fading-in {
  opacity: 1;
}
.srn-a6-preview__img--fading-out {
  opacity: 0;
}

/* Capacity bar */
.srn-a6-cap-bar {
  background: var(--srn-card-dark);
  border: 1px solid var(--srn-border-dark);
  border-radius: var(--srn-radius-card);
  padding: 18px 20px;
}
.srn-a6-cap-bar__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
}
.srn-a6-cap-bar__label {
  font-size: 12px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--srn-sub-dark);
}
.srn-a6-cap-bar__value {
  font-size: 22px;
  font-weight: 700;
  color: var(--srn-cyan);
  letter-spacing: -.01em;
}
.srn-a6-cap-bar__unit {
  font-size: 13px;
  color: var(--srn-sub-dark);
  margin-left: 4px;
}
.srn-a6-cap-bar__track {
  height: 8px;
  border-radius: 9999px;
  background: rgba(255,255,255,0.08);
  overflow: hidden;
  margin-bottom: 8px;
}
.srn-a6-cap-bar__fill {
  height: 100%;
  border-radius: 9999px;
  background: linear-gradient(90deg, var(--srn-teal), var(--srn-cyan));
  width: 0%;
  transition: width 300ms cubic-bezier(.4,0,.2,1);
}
.srn-a6-cap-bar__sub {
  font-size: 12px;
  color: var(--srn-sub-dark);
  text-align: right;
}

/* Build spec summary (below cap bar) */
.srn-a6-specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.srn-a6-spec-chip {
  background: var(--srn-card-dark);
  border: 1px solid var(--srn-border-dark);
  border-radius: 10px;
  padding: 12px 14px;
}
.srn-a6-spec-chip__label {
  font-size: 11px;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--srn-sub-dark);
  margin-bottom: 4px;
}
.srn-a6-spec-chip__value {
  font-size: 16px;
  font-weight: 700;
  color: var(--srn-text-dark);
}
.srn-a6-spec-chip__value span.unit {
  font-size: 12px;
  font-weight: 400;
  color: var(--srn-sub-dark);
  margin-left: 2px;
}

/* ─── Purchase Panel (right) ────────────────────────────────── */
.srn-a6-purchase {
  display: flex;
  flex-direction: column;
  gap: 28px;
  padding-top: 8px;
}
.srn-a6-purchase__tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(34,211,238,0.12);
  border: 1px solid rgba(34,211,238,0.25);
  border-radius: 9999px;
  padding: 5px 12px;
  font-size: 11px;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--srn-cyan);
  width: fit-content;
}
.srn-a6-purchase__tag-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--srn-cyan);
  flex-shrink: 0;
}
.srn-a6-purchase__title {
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 800;
  color: var(--srn-text-dark);
  letter-spacing: -.02em;
  line-height: 1.1;
}
.srn-a6-purchase__subtitle {
  font-size: 15px;
  color: var(--srn-sub-dark);
  line-height: 1.6;
}

/* Price area */
.srn-a6-price-area {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.srn-a6-price-area__label {
  font-size: 12px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--srn-sub-dark);
}
.srn-a6-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.srn-a6-price {
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  color: var(--srn-text-dark);
  letter-spacing: -.03em;
  transition: opacity 150ms ease;
}
.srn-a6-price__currency {
  font-size: 18px;
  font-weight: 500;
  color: var(--srn-sub-dark);
  margin-left: 6px;
}
.srn-a6-price-sub {
  font-size: 13px;
  color: var(--srn-sub-dark);
}

/* CTA area */
.srn-a6-cta-area {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.srn-a6-btn-atc {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 18px 32px;
  background: linear-gradient(135deg, var(--srn-cyan), var(--srn-blue));
  color: #fff;
  border: none;
  border-radius: var(--srn-radius-btn);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: .02em;
  cursor: pointer;
  transition: opacity 200ms ease, transform 120ms ease;
  position: relative;
  overflow: hidden;
}
.srn-a6-btn-atc:hover { opacity: .92; }
.srn-a6-btn-atc:active { transform: scale(.98); }
.srn-a6-btn-atc:disabled { opacity: .55; cursor: not-allowed; }
.srn-a6-btn-atc:focus-visible {
  outline: 2px solid var(--srn-cyan);
  outline-offset: 3px;
}
.srn-a6-btn-atc__spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: srn-a6-spin-{{ sid }} 700ms linear infinite;
  display: none;
  flex-shrink: 0;
}
.srn-a6-btn-atc.is-loading .srn-a6-btn-atc__spinner { display: block; }
.srn-a6-btn-atc.is-loading .srn-a6-btn-atc__label { opacity: .7; }

.srn-a6-atc-error {
  font-size: 13px;
  color: #f87171;
  display: none;
  padding: 10px 14px;
  background: rgba(248,113,113,0.10);
  border: 1px solid rgba(248,113,113,0.25);
  border-radius: 8px;
}
.srn-a6-atc-error.is-visible { display: block; }

.srn-a6-atc-success {
  font-size: 13px;
  color: var(--srn-cyan);
  display: none;
  padding: 10px 14px;
  background: rgba(34,211,238,0.08);
  border: 1px solid rgba(34,211,238,0.20);
  border-radius: 8px;
}
.srn-a6-atc-success.is-visible { display: block; }

/* Klarna line */
.srn-a6-klarna {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--srn-sub-dark);
}
.srn-a6-klarna__logo {
  font-weight: 800;
  color: #ffb3c7;
  letter-spacing: -.01em;
  font-size: 14px;
  flex-shrink: 0;
}
.srn-a6-klarna__text {
  flex: 1;
}

/* Trust icons row */
.srn-a6-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}
.srn-a6-trust-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: var(--srn-sub-dark);
}
.srn-a6-trust-icon {
  width: 18px;
  height: 18px;
  color: var(--srn-cyan);
  flex-shrink: 0;
}

/* ─── Builder Section (light bg) ────────────────────────────── */
.srn-a6-builder {
  background: var(--srn-light);
  padding: 72px 32px 96px;
}
.srn-a6-builder__head {
  max-width: 1280px;
  margin: 0 auto 56px;
  text-align: center;
}
.srn-a6-builder__title {
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 800;
  color: var(--srn-text-light);
  letter-spacing: -.02em;
  margin-bottom: 14px;
}
.srn-a6-builder__sub {
  font-size: 16px;
  color: var(--srn-sub-light);
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.6;
}

.srn-a6-builder__inner {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 48px;
  align-items: start;
}

/* ─── Step Cards ────────────────────────────────────────────── */
.srn-a6-steps {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.srn-a6-step {
  background: #fff;
  border: 1px solid var(--srn-light-2);
  border-radius: var(--srn-radius-card);
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.srn-a6-step__header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px 22px 18px;
  border-bottom: 1px solid var(--srn-light-2);
}
.srn-a6-step__num {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--srn-dark-2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}
.srn-a6-step__num--done {
  background: linear-gradient(135deg, var(--srn-teal), var(--srn-cyan));
}
.srn-a6-step__num svg {
  width: 16px;
  height: 16px;
}
.srn-a6-step__htitle {
  flex: 1;
  font-size: 16px;
  font-weight: 700;
  color: var(--srn-text-light);
}
.srn-a6-step__badge {
  font-size: 11px;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--srn-sub-light);
  background: var(--srn-light-2);
  border-radius: 9999px;
  padding: 4px 10px;
}
.srn-a6-step__body {
  padding: 20px 22px;
}

/* Step 1 – Base (locked) */
.srn-a6-base-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.srn-a6-base-card__icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(20,184,166,0.15), rgba(14,165,233,0.15));
  border: 1px solid rgba(34,211,238,0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.srn-a6-base-card__icon svg {
  width: 22px;
  height: 22px;
  color: var(--srn-cyan);
}
.srn-a6-base-card__info {
  flex: 1;
}
.srn-a6-base-card__name {
  font-size: 15px;
  font-weight: 700;
  color: var(--srn-text-light);
  margin-bottom: 6px;
}
.srn-a6-base-card__specs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.srn-a6-spec-pill {
  font-size: 12px;
  color: var(--srn-sub-light);
  background: var(--srn-light-2);
  border-radius: 9999px;
  padding: 3px 10px;
}
.srn-a6-base-card__price {
  font-size: 13px;
  font-weight: 600;
  color: var(--srn-text-light);
  flex-shrink: 0;
  padding-top: 2px;
}

/* Step 2 – Chassis radio cards */
.srn-a6-chassis-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.srn-a6-chassis-option {
  position: relative;
}
.srn-a6-chassis-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.srn-a6-chassis-card {
  display: block;
  padding: 16px;
  border-radius: 12px;
  border: 2px solid var(--srn-light-2);
  cursor: pointer;
  transition: border-color 120ms ease, background 120ms ease;
  background: #fff;
}
.srn-a6-chassis-card:hover {
  border-color: rgba(34,211,238,0.40);
}
.srn-a6-chassis-option input:checked + .srn-a6-chassis-card {
  border-color: var(--srn-cyan);
  background: rgba(34,211,238,0.05);
}
.srn-a6-chassis-option input:focus-visible + .srn-a6-chassis-card {
  outline: 2px solid var(--srn-cyan);
  outline-offset: 2px;
}
.srn-a6-chassis-card__radio {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid var(--srn-light-2);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 120ms ease;
}
.srn-a6-chassis-option input:checked + .srn-a6-chassis-card .srn-a6-chassis-card__radio {
  border-color: var(--srn-cyan);
  background: var(--srn-cyan);
  box-shadow: 0 0 0 4px rgba(34,211,238,0.15);
}
.srn-a6-chassis-card__radio::after {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
  transition: opacity 120ms ease;
}
.srn-a6-chassis-option input:checked + .srn-a6-chassis-card .srn-a6-chassis-card__radio::after {
  opacity: 1;
}
.srn-a6-chassis-card__name {
  font-size: 14px;
  font-weight: 700;
  color: var(--srn-text-light);
  margin-bottom: 4px;
}
.srn-a6-chassis-card__desc {
  font-size: 12px;
  color: var(--srn-sub-light);
  line-height: 1.5;
  margin-bottom: 8px;
}
.srn-a6-chassis-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.srn-a6-chassis-card__weight {
  font-size: 12px;
  color: var(--srn-sub-light);
}
.srn-a6-chassis-card__price {
  font-size: 13px;
  font-weight: 700;
  color: var(--srn-text-light);
}

/* Step 3 & 4 – Quantity steppers */
.srn-a6-module-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--srn-light-2);
}
.srn-a6-module-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.srn-a6-module-row:first-child {
  padding-top: 0;
}
.srn-a6-module-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--srn-light-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.srn-a6-module-icon svg {
  width: 20px;
  height: 20px;
  color: var(--srn-blue);
}
.srn-a6-module-info {
  flex: 1;
}
.srn-a6-module-info__name {
  font-size: 14px;
  font-weight: 700;
  color: var(--srn-text-light);
  margin-bottom: 3px;
}
.srn-a6-module-info__sub {
  font-size: 12px;
  color: var(--srn-sub-light);
}
.srn-a6-stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1px solid var(--srn-light-2);
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
}
.srn-a6-stepper__btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: none;
  cursor: pointer;
  font-size: 18px;
  font-weight: 700;
  color: var(--srn-text-light);
  transition: background 100ms ease;
  flex-shrink: 0;
}
.srn-a6-stepper__btn:hover { background: var(--srn-light-2); }
.srn-a6-stepper__btn:disabled { opacity: .35; cursor: not-allowed; }
.srn-a6-stepper__btn:focus-visible {
  outline: 2px solid var(--srn-cyan);
  outline-offset: -2px;
}
.srn-a6-stepper__val {
  min-width: 36px;
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  color: var(--srn-text-light);
  padding: 0 4px;
  border-left: 1px solid var(--srn-light-2);
  border-right: 1px solid var(--srn-light-2);
  line-height: 36px;
}
.srn-a6-module-price {
  font-size: 14px;
  font-weight: 700;
  color: var(--srn-text-light);
  min-width: 72px;
  text-align: right;
  flex-shrink: 0;
}

/* ─── Accessories Card ──────────────────────────────────────── */
.srn-a6-acc-card {
  background: #fff;
  border: 1px solid var(--srn-light-2);
  border-radius: var(--srn-radius-card);
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.srn-a6-acc-img-wrap {
  width: 100%;
  aspect-ratio: 16/7;
  overflow: hidden;
}
.srn-a6-acc-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.srn-a6-acc-body {
  padding: 22px;
}
.srn-a6-acc-body__title {
  font-size: 18px;
  font-weight: 700;
  color: var(--srn-text-light);
  margin-bottom: 8px;
}
.srn-a6-acc-body__desc {
  font-size: 14px;
  color: var(--srn-sub-light);
  line-height: 1.6;
  margin-bottom: 16px;
}
.srn-a6-btn-acc {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  border: 2px solid var(--srn-text-light);
  border-radius: var(--srn-radius-btn);
  color: var(--srn-text-light);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: background 150ms ease, color 150ms ease;
}
.srn-a6-btn-acc:hover {
  background: var(--srn-text-light);
  color: #fff;
}
.srn-a6-btn-acc:focus-visible {
  outline: 2px solid var(--srn-cyan);
  outline-offset: 3px;
}

/* ─── Config Summary Card (sticky right) ────────────────────── */
.srn-a6-summary-wrap {
  position: sticky;
  top: 80px;
}
.srn-a6-summary {
  background: var(--srn-dark);
  border: 1px solid var(--srn-border-dark);
  border-radius: var(--srn-radius-card);
  overflow: hidden;
}
.srn-a6-summary__head {
  padding: 20px 22px 16px;
  border-bottom: 1px solid var(--srn-border-dark);
}
.srn-a6-summary__htitle {
  font-size: 14px;
  font-weight: 700;
  color: var(--srn-text-dark);
  letter-spacing: .03em;
  text-transform: uppercase;
}
.srn-a6-summary__body {
  padding: 18px 22px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.srn-a6-sum-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--srn-border-dark);
}
.srn-a6-sum-row:last-child { border-bottom: none; }
.srn-a6-sum-row__left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}
.srn-a6-sum-row__icon {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: var(--srn-card-dark-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.srn-a6-sum-row__icon svg {
  width: 14px;
  height: 14px;
  color: var(--srn-cyan);
}
.srn-a6-sum-row__name {
  font-size: 13px;
  color: var(--srn-text-dark);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.srn-a6-sum-row__qty {
  font-size: 12px;
  color: var(--srn-sub-dark);
  flex-shrink: 0;
}
.srn-a6-sum-row__price {
  font-size: 13px;
  font-weight: 700;
  color: var(--srn-text-dark);
  flex-shrink: 0;
}

.srn-a6-sum-divider {
  height: 1px;
  background: var(--srn-border-dark);
  margin: 6px 0;
}

.srn-a6-sum-stats {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 0;
  border-bottom: 1px solid var(--srn-border-dark);
}
.srn-a6-sum-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.srn-a6-sum-stat__label {
  font-size: 12px;
  color: var(--srn-sub-dark);
}
.srn-a6-sum-stat__value {
  font-size: 13px;
  font-weight: 600;
  color: var(--srn-text-dark);
  transition: opacity 150ms ease;
}

.srn-a6-sum-total {
  padding: 16px 0 12px;
  border-bottom: 1px solid var(--srn-border-dark);
}
.srn-a6-sum-total__label {
  font-size: 11px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--srn-sub-dark);
  margin-bottom: 4px;
}
.srn-a6-sum-total__price {
  font-size: 28px;
  font-weight: 800;
  color: var(--srn-text-dark);
  letter-spacing: -.02em;
  transition: opacity 150ms ease;
}
.srn-a6-sum-total__currency {
  font-size: 14px;
  font-weight: 500;
  color: var(--srn-sub-dark);
  margin-left: 4px;
}
.srn-a6-sum-klarna {
  font-size: 12px;
  color: var(--srn-sub-dark);
  margin-top: 4px;
}

.srn-a6-summary__footer {
  padding: 16px 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.srn-a6-sum-btn-atc {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 15px 24px;
  background: linear-gradient(135deg, var(--srn-cyan), var(--srn-blue));
  color: #fff;
  border: none;
  border-radius: var(--srn-radius-btn);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 200ms ease;
}
.srn-a6-sum-btn-atc:hover { opacity: .90; }
.srn-a6-sum-btn-atc:disabled { opacity: .50; cursor: not-allowed; }
.srn-a6-sum-btn-atc:focus-visible {
  outline: 2px solid var(--srn-cyan);
  outline-offset: 3px;
}
.srn-a6-sum-btn-atc__spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: srn-a6-spin-{{ sid }} 700ms linear infinite;
  display: none;
  flex-shrink: 0;
}
.srn-a6-sum-btn-atc.is-loading .srn-a6-sum-btn-atc__spinner { display: block; }

.srn-a6-sum-meta {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.srn-a6-sum-meta-line {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  color: var(--srn-sub-dark);
}
.srn-a6-sum-meta-icon {
  width: 14px;
  height: 14px;
  color: var(--srn-teal);
  flex-shrink: 0;
}

/* ─── Sticky Mobile Bar ─────────────────────────────────────── */
.srn-a6-sticky-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: var(--srn-dark);
  border-top: 1px solid var(--srn-border-dark);
  padding: 14px 20px;
  align-items: center;
  gap: 16px;
  box-shadow: 0 -8px 32px rgba(0,0,0,0.25);
}
.srn-a6-sticky-bar__price-block {
  flex: 1;
}
.srn-a6-sticky-bar__label {
  font-size: 11px;
  color: var(--srn-sub-dark);
  margin-bottom: 1px;
}
.srn-a6-sticky-bar__price {
  font-size: 20px;
  font-weight: 800;
  color: var(--srn-text-dark);
  letter-spacing: -.01em;
}
.srn-a6-sticky-bar__currency {
  font-size: 12px;
  color: var(--srn-sub-dark);
  margin-left: 3px;
}
.srn-a6-sticky-bar__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 24px;
  background: linear-gradient(135deg, var(--srn-cyan), var(--srn-blue));
  color: #fff;
  border: none;
  border-radius: var(--srn-radius-btn);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
}
.srn-a6-sticky-bar__btn:disabled { opacity: .5; cursor: not-allowed; }
.srn-a6-sticky-bar__btn:focus-visible {
  outline: 2px solid var(--srn-cyan);
  outline-offset: 3px;
}
.srn-a6-sticky-bar__spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: srn-a6-spin-{{ sid }} 700ms linear infinite;
  display: none;
  flex-shrink: 0;
}
.srn-a6-sticky-bar__btn.is-loading .srn-a6-sticky-bar__spinner { display: block; }

/* ─── Animations ────────────────────────────────────────────── */
@keyframes srn-a6-spin-{{ sid }} {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ─── Responsive ────────────────────────────────────────────── */
@media (max-width: 899px) {
  .srn-a6-hero__inner {
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 0;
  }
  .srn-a6-hero {
    padding: 40px 20px 48px;
  }
  .srn-a6-preview {
    position: static;
  }
  .srn-a6-builder {
    padding: 48px 20px 120px;
  }
  .srn-a6-builder__inner {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .srn-a6-summary-wrap {
    position: static;
  }
  .srn-a6-chassis-grid {
    grid-template-columns: 1fr;
  }
  .srn-a6-specs {
    grid-template-columns: 1fr 1fr;
  }
  .srn-a6-sticky-bar {
    display: flex;
  }
}

@media (max-width: 480px) {
  .srn-a6-specs {
    grid-template-columns: 1fr 1fr;
  }
  .srn-a6-hero {
    padding: 32px 16px 40px;
  }
  .srn-a6-builder {
    padding: 40px 16px 120px;
  }
}

/* ─── Reduced Motion ────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  #srn-a6builder-{{ sid }} * {
    transition: none !important;
    animation: none !important;
  }
}
