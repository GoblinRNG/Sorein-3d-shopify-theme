<style>
  #srn-usecases-{{ section.id }} {
    background: #f8f9fb;
    padding: 80px 0 96px;
    overflow: hidden;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #111318;
    margin: 12px 0 16px;
    line-height: 1.15;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(17,19,24,0.60);
    margin: 0;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__scroll-wrap {
    padding: 0 24px;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
  }

  #srn-usecases-{{ section.id }} .srn-usecases__grid::-webkit-scrollbar {
    display: none;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card {
    flex: 0 0 260px;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid rgba(17,19,24,0.09);
    border-radius: 16px;
    padding: 32px 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1),
                box-shadow 0.35s cubic-bezier(0.22,1,0.36,1),
                border-color 0.25s ease;
    will-change: transform;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card:hover,
  #srn-usecases-{{ section.id }} .srn-usecase-card:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(34,211,238,0.10), 0 4px 12px rgba(17,19,24,0.08);
    border-color: rgba(34,211,238,0.40);
    outline: none;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card__icon {
    font-size: 2.25rem;
    line-height: 1;
    display: block;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card__title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #111318;
    letter-spacing: -0.01em;
    margin: 0;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card__desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(17,19,24,0.60);
    margin: 0;
    flex: 1;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0ea5e9;
    text-decoration: none;
    letter-spacing: 0.01em;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    transition: gap 0.2s ease;
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card:hover .srn-usecase-card__link {
    gap: 8px;
  }

  /* Fade-up animation states */
  #srn-usecases-{{ section.id }} .srn-usecase-card.srn-animate {
    opacity: 0;
    transform: translateY(28px);
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card.srn-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1),
                transform 0.55s cubic-bezier(0.22,1,0.36,1);
  }

  #srn-usecases-{{ section.id }} .srn-usecase-card.srn-visible:hover {
    transform: translateY(-6px);
  }

  @media (min-width: 900px) {
    #srn-usecases-{{ section.id }} .srn-usecases__scroll-wrap {
      padding: 0;
    }

    #srn-usecases-{{ section.id }} .srn-usecases__grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }

    #srn-usecases-{{ section.id }} .srn-usecase-card {
      flex: unset;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #srn-usecases-{{ section.id }} .srn-usecase-card.srn-animate {
      opacity: 1;
      transform: none;
    }
    #srn-usecases-{{ section.id }} .srn-usecase-card,
    #srn-usecases-{{ section.id }} .srn-usecase-card:hover,
    #srn-usecases-{{ section.id }} .srn-usecase-card.srn-visible {
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      transform: none !important;
    }
  }
</style>

<section id="srn-usecases-{{ section.id }}" aria-labelledby="srn-usecases-h2-{{ section.id }}">
  <div class="srn-container">
    <div class="srn-usecases__header">
      {% if section.settings.eyebrow != blank %}
        <p class="srn-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="srn-usecases__h2" id="srn-usecases-h2-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="srn-usecases__sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <div class="srn-container">
    <div class="srn-usecases__scroll-wrap">
      <div class="srn-usecases__grid" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'use_case' %}
            {% assign card_url = block.settings.link_url %}
            {% assign card_tag = 'div' %}
            {% if card_url != blank %}
              {% assign card_tag = 'a' %}
            {% endif %}
            <{{ card_tag }}
              class="srn-usecase-card srn-animate"
              role="listitem"
              {% if card_url != blank %}
                href="{{ card_url }}"
              {% endif %}
              tabindex="0"
              style="transition-delay: {{ forloop.index0 | times: 80 }}ms;"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.icon != blank %}
                <span class="srn-usecase-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <h3 class="srn-usecase-card__title">{{ block.settings.title }}</h3>
              {% if block.settings.description != blank %}
                <p class="srn-usecase-card__desc">{{ block.settings.description }}</p>
              {% endif %}
              {% if card_url != blank %}
                <span class="srn-usecase-card__link" aria-hidden="true">
                  {{ block.settings.link_label | default: 'Explore' }} →
                </span>
              {% endif %}
            </{{ card_tag }}>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('srn-usecases-{{ section.id }}');
  if (!section) return;

  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var cards = section.querySelectorAll('.srn-usecase-card.srn-animate');

  if (prefersReduced) {
    cards.forEach(function(card) {
      card.classList.remove('srn-animate');
    });
    return;
  }

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('srn-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  cards.forEach(function(card) {
    observer.observe(card);
  });
})();
</script>

{% schema %}
{
  "name": "Use Cases",
  "tag": "section",
  "class": "srn-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Find your fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Energy for every life"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether you're protecting your home, powering a cabin, or hitting the road — Sorein has a system built for your life."
    }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Use Case Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🏠"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Home Backup"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Power your home when the grid fails"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Use Cases",
      "blocks": [
        {
          "type": "use_case",
          "settings": {
            "icon": "🏠",
            "title": "Home Backup",
            "description": "Power your home when the grid fails",
            "link_label": "Explore"
          }
        },
        {
          "type": "use_case",
          "settings": {
            "icon": "🏔️",
            "title": "Cabin & Off-Grid",
            "description": "Energy independence for your cabin",
            "link_label": "Explore"
          }
        },
        {
          "type": "use_case",
          "settings": {
            "icon": "🚐",
            "title": "RV & Camping",
            "description": "Clean power on the road",
            "link_label": "Explore"
          }
        },
        {
          "type": "use_case",
          "settings": {
            "icon": "⚡",
            "title": "Emergency Power",
            "description": "Ready when you need it most",
            "link_label": "Explore"
          }
        },
        {
          "type": "use_case",
          "settings": {
            "icon": "☀️",
            "title": "Solar Charging",
            "description": "Harness free sun energy",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
