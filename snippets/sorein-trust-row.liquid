{%- comment -%}
  Sorein Trust Row Snippet
  Usage:
    {% render 'sorein-trust-row',
       delivery_text: 'Free shipping over €499',
       warranty_text: '5-year warranty',
       support_text: '24/7 expert support',
       checkout_text: 'Secure checkout'
    %}
  If not passed, falls back to generic defaults.
{%- endcomment -%}

{%- liquid
  assign t_checkout = checkout_text
  if t_checkout == blank
    assign t_checkout = 'Secure checkout'
  endif
  assign t_delivery = delivery_text
  if t_delivery == blank
    assign t_delivery = 'Free shipping over €499'
  endif
  assign t_warranty = warranty_text
  if t_warranty == blank
    assign t_warranty = '5-year warranty'
  endif
  assign t_support = support_text
  if t_support == blank
    assign t_support = '24/7 support'
  endif
-%}

<div class="srn-trust-row" role="list" aria-label="Trust signals">
  <div class="srn-trust-row__item" role="listitem">
    <span class="srn-trust-row__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
      </svg>
    </span>
    <span class="srn-trust-row__label">{{ t_checkout }}</span>
  </div>
  <span class="srn-trust-row__sep" aria-hidden="true">·</span>
  <div class="srn-trust-row__item" role="listitem">
    <span class="srn-trust-row__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </span>
    <span class="srn-trust-row__label">{{ t_delivery }}</span>
  </div>
  <span class="srn-trust-row__sep" aria-hidden="true">·</span>
  <div class="srn-trust-row__item" role="listitem">
    <span class="srn-trust-row__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </span>
    <span class="srn-trust-row__label">{{ t_warranty }}</span>
  </div>
  <span class="srn-trust-row__sep" aria-hidden="true">·</span>
  <div class="srn-trust-row__item" role="listitem">
    <span class="srn-trust-row__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.07 1.21 2 2 0 012.03 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
      </svg>
    </span>
    <span class="srn-trust-row__label">{{ t_support }}</span>
  </div>
</div>

<style>
  .srn-trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 4px;
    padding: 12px 0;
  }
  .srn-trust-row__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .srn-trust-row__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #22d3ee;
    flex-shrink: 0;
  }
  .srn-trust-row__label {
    font-size: 12px;
    font-weight: 500;
    color: rgba(17,19,24,0.65);
    white-space: nowrap;
  }
  .srn-trust-row__sep {
    font-size: 12px;
    color: rgba(17,19,24,0.25);
    line-height: 1;
    padding: 0 2px;
    display: none;
  }
  @media (min-width: 540px) {
    .srn-trust-row__sep {
      display: inline;
    }
  }

  /* Dark variant — add class srn-trust-row--dark to parent or change via context */
  .srn-trust-row--dark .srn-trust-row__label {
    color: rgba(244,246,250,0.55);
  }
  .srn-trust-row--dark .srn-trust-row__sep {
    color: rgba(244,246,250,0.20);
  }
  .srn-trust-row--dark .srn-trust-row__icon {
    color: #22d3ee;
  }
</style>
