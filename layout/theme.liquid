<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Canonical URL {%- endcomment -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph / Social Meta {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- elsif settings.logo -%}
    <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
  {%- endif -%}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  {%- comment -%} Shopify Required {%- endcomment -%}
  {{ content_for_header }}

  {%- comment -%} Theme CSS Custom Properties from Settings {%- endcomment -%}
  <style>
    :root {
      --srn-color-primary: {{ settings.color_primary | default: '#22d3ee' }};
      --srn-color-secondary: {{ settings.color_secondary | default: '#0ea5e9' }};
      --srn-color-accent: {{ settings.color_accent | default: '#14b8a6' }};
      --srn-button-radius: {{ settings.button_radius | default: 10 }}px;
      --srn-page-width: {{ settings.page_width | default: 1280 }}px;
      --srn-section-padding: {{ settings.section_padding | default: 48 }}px;
      {%- if settings.type_body_font -%}
        --srn-font-body-weight: {{ settings.type_body_font.baseline_ratio }};
      {%- endif -%}
      --srn-type-base-size: {{ settings.type_base_size | default: 16 }}px;
    }
  </style>

  {%- comment -%} Preload critical assets {%- endcomment -%}
  <link rel="preload" href="{{ 'sorein-base.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'sorein-base.js' | asset_url }}" as="script">

  {%- comment -%} Theme Stylesheets {%- endcomment -%}
  {{ 'sorein-fonts.css' | asset_url | stylesheet_tag }}
  {{ 'sorein-base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Shopify font picker support {%- endcomment -%}
  {%- if settings.type_header_font -%}
    <style>
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      :root {
        --srn-font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --srn-font-heading-weight: {{ settings.type_header_font.weight }};
        --srn-font-heading-style: {{ settings.type_header_font.style }};
      }
    </style>
  {%- endif -%}

  {%- if settings.type_body_font -%}
    <style>
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      :root {
        --srn-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --srn-font-body-weight: {{ settings.type_body_font.weight }};
        --srn-font-body-style: {{ settings.type_body_font.style }};
      }
    </style>
  {%- endif -%}
</head>

<body
  class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}{% if customer %} customer-logged-in{% endif %}"
  data-cart-type="{{ settings.cart_type | default: 'page' }}"
>

  {%- comment -%} Accessibility: Skip to content {%- endcomment -%}
  <a class="srn-skip-link srn-visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {%- comment -%} Announcement Bar {%- endcomment -%}
  {%- if settings.show_announcement and settings.announcement_text != blank -%}
    <div class="srn-announcement-bar" role="complementary" aria-label="Announcement">
      <div class="srn-container">
        {%- if settings.announcement_link != blank -%}
          <a href="{{ settings.announcement_link }}" class="srn-announcement-bar__link">
            {{ settings.announcement_text }}
          </a>
        {%- else -%}
          <p class="srn-announcement-bar__text">{{ settings.announcement_text }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Site Header {%- endcomment -%}
  <header role="banner">
    {%- section 'header' -%}
  </header>

  {%- comment -%} Main Content {%- endcomment -%}
  <main id="MainContent" class="srn-main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Site Footer {%- endcomment -%}
  <footer role="contentinfo">
    {%- section 'footer' -%}
  </footer>

  {%- comment -%} Cart Drawer Placeholder {%- endcomment -%}
  <div
    id="srn-cart-drawer"
    class="srn-cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.title' | t }}"
    aria-hidden="true"
    tabindex="-1"
  >
    <div class="srn-cart-drawer__overlay" data-cart-drawer-close></div>
    <div class="srn-cart-drawer__panel">
      <div class="srn-cart-drawer__header">
        <h2 class="srn-cart-drawer__title">{{ 'cart.title' | t }}</h2>
        <button
          class="srn-cart-drawer__close srn-btn srn-btn--ghost srn-btn--sm"
          data-cart-drawer-close
          aria-label="{{ 'general.close' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="srn-cart-drawer__body" id="srn-cart-drawer-items">
        {%- comment -%} Populated via JS {%- endcomment -%}
      </div>
      <div class="srn-cart-drawer__footer">
        <div class="srn-cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span id="srn-cart-drawer-subtotal"></span>
        </div>
        <a href="{{ routes.checkout_url }}" class="srn-btn srn-btn--primary srn-btn--lg" style="width:100%;">
          {{ 'cart.checkout' | t }}
        </a>
        <a href="{{ routes.cart_url }}" class="srn-btn srn-btn--ghost" style="width:100%;margin-top:8px;">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} Toast Notification Container {%- endcomment -%}
  <div id="srn-toast-container" class="srn-toast-container" aria-live="polite" aria-atomic="false"></div>

  {%- comment -%} Scroll Lock Overlay (used by mobile menu / drawer) {%- endcomment -%}
  <div id="srn-scroll-overlay" class="srn-scroll-overlay" aria-hidden="true"></div>

  {%- comment -%} Global JS {%- endcomment -%}
  <script src="{{ 'sorein-base.js' | asset_url }}" defer></script>

  {%- comment -%} Predictive search / additional scripts loaded by sections {%- endcomment -%}
  {%- if request.design_mode -%}
    <script>
      // Theme editor helpers
      document.addEventListener('shopify:section:load', function(e) {
        window.SoreinTheme && window.SoreinTheme.onSectionLoad && window.SoreinTheme.onSectionLoad(e);
      });
    </script>
  {%- endif -%}

</body>
</html>
